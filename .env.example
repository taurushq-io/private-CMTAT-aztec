# Copy to .env and fill in. `.env` is gitignored; this file is not, so keep real
# credentials out of it.
#
# `yarn test:nr` needs none of this: the Noir suite runs against the TXE and reads no
# environment. A local end-to-end run needs only L1_MNEMONIC. The rest is for testnet.

# ---- Network endpoints ---------------------------------------------------------
# L1 RPC. Read by scripts/fees.ts (`yarn fees`), which throws if unset. For a local
# network this is anvil: http://localhost:8545 
L1_URL=https://ethereum-sepolia-rpc.publicnode.com

# Aztec node. Read by setup_pxe_testnet.ts for `yarn deploy`, `yarn deploy-account`
# and `yarn interaction`, which throw if unset. setup_pxe.ts and multiple_pxe.ts
# default to http://localhost:8080, so a local run needs nothing here.
NODE_URL="https://aztec-alpha-testnet-fullnode.zkv.xyz" # testnet

# ---- Deployed contract ---------------------------------------------------------
# An already-deployed token, so `yarn interaction` can act on it instead of deploying
# a new one. Read only by scripts/interaction.ts. Format: 0x + 64 hex characters.
# Get one from `yarn deploy`, which prints "CMTA Token Contract deployed at: <address>".
# Empty on purpose: the address this file used to carry was deployed in June 2025
# against Aztec 0.87 and the testnet has been reset since, so it resolves to nothing.
CMTA_TOKEN_CONTRACT_ADDRESS=

# ---- Accounts ------------------------------------------------------------------
# Schnorr accounts rebuilt by src/utils/create_account_from_env.ts, reached only from
# `yarn interaction`. The secret is the account's master secret and the signing key is
# derived from it; the salt enters the address derivation, so the same secret with a
# different salt is a different account. Recreating from the same pair always yields
# the same address, which is how the testnet scripts keep the same accounts across runs.
#
# Both are random field elements, 0x + 64 hex characters. `yarn deploy-account`
# generates a pair and prints the secret and the resulting address.
# Empty on purpose
SECRET1=
SALT1=
SECRET2=
SALT2=

# ---- L1 chain ------------------------------------------------------------------
# Sepolia's chain ID, the L1 this testnet settles to. No TypeScript here reads it: it
# is for the `aztec` and `aztec-wallet` CLIs, which take it as --l1-chain-id and accept
# $L1_CHAIN_ID as the environment form.
L1_CHAIN_ID="11155111" # Sepolia

# ---- L1 signer -----------------------------------------------------------------
# Mnemonic signing L1 transactions: the Fee Juice portal deposit in the e2e suite and in
# `yarn fees`. Read by src/utils/l1_dev_account.ts, which throws when unset rather than
# falling back, so no credential is ever a literal in the source. The value below is
# Foundry/anvil's published default, which `aztec start --local-network` also uses:
# fine for chain 31337, never for a network where the accounts are real.
L1_MNEMONIC="test test test test test test test test test test test junk"

